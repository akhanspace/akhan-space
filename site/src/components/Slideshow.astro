---
interface Props {
  images: string[];
  id?: string;
}
const { images, id = "slideshow" } = Astro.props;
---

<div class="slideshow" id={id} data-slideshow>
  {
    images.map((src, i) => (
      <figure class="slideshow__slide" data-slide class={i === 0 ? "is-active" : undefined}>
        <img src={src} alt="" />
      </figure>
    ))
  }
</div>

<style>
  .slideshow {
    position: relative;
    width: 100%;
    max-width: 791px;
    margin: 0 auto;
    aspect-ratio: 791 / 444;
    overflow: hidden;
    touch-action: pan-y;
  }

  .slideshow__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .slideshow__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .slideshow__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
