---
import BaseLayout from "../layouts/BaseLayout.astro";

const panels = [
  "cuisine.png",
  "cultstats.png",
  "racialstats.png",
  "culturaltreatment.png",
  "racialtreatment.png",
  "customers.png",
  "decor.png",
  "environment.png",
  "history.png",
  "safespace.png",
];
---

<BaseLayout
  title="Listening Device"
  active="work"
  pageTitle="Listening Device"
  pageTitleHref="/listening-device"
>
  <div class="stage">
    {
      panels.map((file) => (
        <img
          class="dragme"
          src={`/assets/${file}`}
          alt="drag-and-drop image script"
          title="drag-and-drop image script"
          draggable="false"
        />
      ))
    }
  </div>
</BaseLayout>

<style>
  .stage {
    position: relative;
    min-height: 70vh;
    max-width: 1100px;
    margin: 0 auto;
  }

  .dragme {
    position: relative;
    width: 270px;
    height: 203px;
    object-fit: contain;
    margin: 8px;
    cursor: move;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>

<script>
  import { initDragme } from "../scripts/dragme.js";
  initDragme();
</script>
