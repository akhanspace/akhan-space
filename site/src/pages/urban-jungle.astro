---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Urban Jungle"
  active="work"
  pageTitle="Urban Jungle"
  pageTitleHref="/urban-jungle"
>
  <article class="project">
    <img
      class="hero"
      src="/images/primate house - urban jungle.jpg"
      alt="Urban Jungle / Primate House"
    />
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 963px;
    margin: 0 auto;
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
